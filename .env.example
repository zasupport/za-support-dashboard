# ZA Support Dashboard — Environment Variables
# Copy to .env.local for local development
# Set all of these in Vercel dashboard for production

# Backend API (server-side only — never NEXT_PUBLIC_)
ZA_API_URL=https://api.zasupport.com
ZA_API_TOKEN=<agent bearer token — see ~/.za-keys-pending.env>

# Dashboard auth (password protection for /login gate)
DASHBOARD_PASSWORD=<strong password>

# Public vars (available in browser)
NEXT_PUBLIC_API_URL=https://api.zasupport.com
NEXT_PUBLIC_VERSION=0.2.0
